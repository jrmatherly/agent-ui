# =============================================================================
# Agent UI Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
#
# Quick Start:
#   cp .env.example .env
#   # Edit .env with your values
#   # Generate secrets: openssl rand -base64 32

# -----------------------------------------------------------------------------
# Required: Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string (pgvector extension recommended for knowledge bases)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=MODE
#
# Common configurations:
#   postgresql://agno:agno@localhost:5432/agent_ui       - Hybrid mode (recommended)
#   postgresql://agno:agno@host.docker.internal:5432/agent_ui - Both in Docker
#   postgresql://agno:agno@agentos-db:5432/agent_ui      - Shared network
#
DATABASE_URL=postgresql://agno:agno@localhost:5432/agent_ui

# -----------------------------------------------------------------------------
# Required: Authentication (Better Auth)
# -----------------------------------------------------------------------------
# Secret key for signing tokens and encrypting sessions
# MUST be at least 32 characters for security
# Generate with: `openssl rand -base64 32`
BETTER_AUTH_SECRET="your-super-secret-better-auth-key"

# Public URL for authentication callbacks (no trailing slash)
# Used for OAuth redirects and email verification links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional: Fail-safe Admin Account
# -----------------------------------------------------------------------------
# Emergency admin access when SSO is unavailable or misconfigured
# Account is auto-created on first startup if both are set and user doesn't exist
# Generate password: `openssl rand -base64 24`
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# AgentOS Backend
# -----------------------------------------------------------------------------
# AgentOS backend API URL
# See docs/AGENTOS_BACKEND.md for all connectivity options
#
# Common configurations:
#   http://localhost:8000              - Hybrid mode (recommended): agent-ui on host, agentos-docker in Docker
#   http://host.docker.internal:8000   - Both in Docker via host gateway
#   http://agentos:8000                - Both in Docker via shared network
#
NEXT_PUBLIC_AGENT_OS_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# AgentOS JWT Authentication (RS256)
# -----------------------------------------------------------------------------
# Required for production: Private key for signing JWTs
# Generate with: openssl genrsa -out private.pem 2048
# The corresponding public key goes to AgentOS as JWT_VERIFICATION_KEY
# Note: Use literal \n for newlines or use a single line
AGENTOS_JWT_PRIVATE_KEY=

# Optional: JWT expiration in seconds (default: 900 = 15 minutes)
AGENTOS_JWT_EXPIRES_IN=900

# -----------------------------------------------------------------------------
# Redis (Session Caching & Rate Limiting)
# -----------------------------------------------------------------------------
# Improves performance for session lookups and enables rate limiting
#
# Common configurations:
#   redis://localhost:6379              - Hybrid mode (recommended)
#   redis://host.docker.internal:6379   - Both in Docker
#   redis://agentos-redis:6379          - Shared network
#
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Optional: Enterprise SSO - Microsoft Entra ID (Azure AD)
# -----------------------------------------------------------------------------
# Register an app in Azure Portal > App registrations
# See: https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=

# SSO domain for provider matching (your organization's email domain)
# SSO_DOMAIN=yourcompany.com

# -----------------------------------------------------------------------------
# Docker Configuration
# -----------------------------------------------------------------------------
# Used by compose.yaml and CI/CD pipelines
IMAGE_NAME=agent-ui
IMAGE_TAG=latest
PORT=3000

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
# Disable Next.js telemetry (set automatically by mise.toml)
# NEXT_TELEMETRY_DISABLED=1

# E2E test configuration (Playwright)
# E2E_BASE_URL=http://localhost:3000
